Table users {
	id int [pk, increment]
	email varchar(255) [unique, not null]
	password varchar(255) [not null]
	first_name varchar(25) [not null]
	last_name varchar(25)
	gender gender
	role role [default: role.USER, not null]
	created_at timestamp
	updated_at timestamp

	indexes {
		email
	}

}

Table pets {
	id int [pk, increment]
	user_id int [not null]
	name varchar(30)
	about text
	gender gender
	birthday date
	microchip_id string
	pet_type_id int [not null]
	breed_id int
	lost bool [default: false]
	created_at timestamp
	updated_at timestamp
}

Table pet_types {
	id int [pk, increment]
	value varchar(50) [unique, not null]
}

Table breeds {
	id int [pk, increment]
	value varchar(50) [unique, not null]
	pet_type_id int [not null]
}

Table vet_clinics {
	id int [pk, increment]
	name varchar(30)
	about text
	address varchar(255)
	created_at timestamp
	updated_at timestamp
}

Enum role {
	ADMIN
	USER
}

Enum gender {
	MALE
	FEMALE
}


Ref: pets.user_id > users.id
Ref: pets.pet_type_id > pet_types.id
Ref: pets.breed_id >? breeds.id
Ref: breeds.pet_type_id > pet_types.id

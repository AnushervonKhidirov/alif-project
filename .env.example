APP_ENV=dev

# Server
HTTP_PORT=8080
HTTP_HOST=localhost
HTTP_TIMEOUT=4s
HTTP_IDLE_TIMEOUT=60s


# PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret_password
DB_NAME=pet_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secret_password

# Token
TOKEN_ACCESS_KEY=access_secret_key
TOKEN_REFRESH_KEY=refresh_secret_key
TOKEN_ACCESS_EXPIRATION=2h
TOKEN_REFRESH_EXPIRATION=168h # 1 weak
